        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(community_like_outbox_polls_empty_total{job=\"picture-backend\"}[5m])) / clamp_min(sum(rate(community_like_outbox_polls_total{job=\"picture-backend\"}[5m])), 0.001)",
