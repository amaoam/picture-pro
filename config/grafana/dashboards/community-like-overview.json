  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "点赞接口请求速率（RPS）",
      "description": "按 Spring MVC 的低基数 URI 标签筛选互动接口；若无数据，先在 Prometheus 查询 uri 标签值。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"picture-backend\",uri=~\".*(like|community).*\"}[1m]))",
          "legendFormat": "RPS",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "点赞/社区接口 P95 延迟",
      "description": "需要开启 http.server.requests 的 percentile histogram；Prometheus 的秒单位在 Grafana 中显示为秒。",
